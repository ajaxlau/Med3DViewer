{
  "name": "med3dviewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "npm run check:manifests && npm run build && npm run check:dist",
    "deploy:cloudflare": "npm run check:dist && wrangler deploy --config ./wrangler.jsonc --assets ./dist",
    "preview:cloudflare": "npm run check:dist && wrangler preview --config ./wrangler.jsonc",
    "check:cloudflare": "npm run check:dist && wrangler deploy --config ./wrangler.jsonc --assets ./dist --dry-run",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "check:manifests": "node scripts/validate-manifests.mjs",
    "check:dist": "node scripts/validate-dist.mjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "deploy:shares:test": "node scripts/share-cloudflare.mjs test deploy",
    "check:shares:test": "node scripts/share-cloudflare.mjs test check",
    "preview:shares:beta": "node scripts/share-cloudflare.mjs beta preview",
    "deploy:shares:main": "node scripts/share-cloudflare.mjs main deploy",
    "configure:shares": "node scripts/share-cloudflare.mjs",
    "check:shares:beta": "node scripts/share-cloudflare.mjs beta check",
    "check:shares:beta:cleanup": "node scripts/share-cloudflare.mjs beta cleanup-check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@humanwhocodes/ico-to-png": "^1.1.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "4.135.0"
  }
}
