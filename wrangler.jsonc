{
  "name": "ntec3dpo-m3dv-sharing-test",
  "compatibility_date": "2026-10-03",
  "main": "./worker/entry.ts",
  "vars": { "SHARES_ENABLED": "false" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/shares", "/api/shares/*", "/s/*"]
  },
  "previews": {}
}
